#
# Reference sudoers policy for flake-pilot
# ========================================
#
# WARNING: Every rule in this file which runs a program as root makes
# the users it applies to equivalent to root. Read this header before
# using the file.
#
# Why the rules grant root
# ------------------------
# flake-pilot does not install a setuid binary. Every action which
# needs more privileges than the calling user has is passed to sudo.
# The programs called this way are general purpose tools: podman,
# mount, tar, rsync, cp, chmod, iptables, ip, systemctl and others.
# flake-pilot calls them with arguments which differ from call to
# call: temporary directories, image files, container names, network
# addresses. sudoers can therefore not restrict them to the calls
# flake-pilot makes. A user who may run them as root may also run
# them directly, outside of flake-pilot and with any arguments, e.g:
#
#   sudo /usr/bin/podman run --privileged -v /:/host IMAGE chroot /host
#   sudo /usr/bin/chmod u+s /usr/bin/bash
#   sudo /usr/bin/cp ./my-sudoers /etc/sudoers
#   sudo /usr/bin/mount --bind ./my-passwd /etc/passwd
#   sudo /usr/sbin/iptables --modprobe=./my-program -A INPUT -j LOG
#   sudo /usr/bin/sh
#
# This file therefore does not try to restrict the arguments. Doing so
# would break flake-pilot without making the rules safe. The rules
# are grouped by feature instead and each group states what it
# grants. Only add users to the flake-pilot group whom you would also
# trust with the root account of this host. Delete the groups of the
# features you do not use. Where possible, prefer flakes which need
# no root privileges at all: podman flakes registered by the user
# who runs them. See the chapter "Privileges and Trust" in the
# flake-pilot user guide.
#
# Not active as shipped
# ---------------------
# sudo ignores files in /etc/sudoers.d whose name contains a dot.
# This file therefore stays inactive even when copied there under its
# original name. To activate it:
#
#   1. Edit a copy and delete the groups of the features you do
#      not use
#   2. groupadd --system flake-pilot
#   3. visudo --check --file ./flake-pilot.sudoers
#   4. install -m 0440 -o root -g root ./flake-pilot.sudoers \
#          /etc/sudoers.d/flake-pilot
#   5. usermod --append --groups flake-pilot USER
#
# Passwords
# ---------
# The rules ask for the password of the calling user, which is the
# sudo default. sudo caches it for a few minutes, as configured by
# timestamp_timeout. NOPASSWD does not give the user any additional
# privilege, but it allows every process running under the account
# of the user, e.g a malicious build script, to become root without
# any interaction. It is therefore not used here.
#
# Programs are given by their absolute path, the way flake-pilot
# passes them to sudo. Distributions without a merged /usr may
# install some of them elsewhere. Adapt the paths here and in
# flake-pilot (common/src/defaults.rs) in that case.
#

#
# podman flakes registered by the calling user (rootless podman)
# -------------------------------------------------------------------
# Used by: podman-pilot and 'flake-ctl podman' for flakes in the
#          registry of the calling user, ~/.config/flakes
# Runs as: the calling user
# GRANTS:  nothing
#
# podman is called through sudo also in this case, but as the
# calling user. sudo requires a rule even for that. sudoers cannot
# refer to "the calling user" in a group rule, so every user needs
# a rule of their own. Do NOT use the following instead:
#
#   %flake-pilot ALL = (%flake-pilot) FLAKE_PODMAN
#
# That rule lets every member run podman as any other member and
# thereby access their containers, their data and their home
# directory.
#
# flake-pilot uses the two environment variables to select the
# container storage podman operates on. With the root podman of
# system wide flakes, see below, a user can point podman at a storage
# setup of their own choice. This grants nothing beyond the root
# podman rule itself.
#
Cmnd_Alias FLAKE_PODMAN = /usr/bin/podman
Defaults!FLAKE_PODMAN env_keep += "CONTAINERS_STORAGE_CONF XDG_RUNTIME_DIR"

# USER ALL = (USER) FLAKE_PODMAN

#
# podman flakes registered system wide, /usr/share/flakes
# -------------------------------------------------------------------
# Used by: podman-pilot and 'flake-ctl podman' for system wide flakes
# Runs as: root
# GRANTS:  ROOT
#
# The application runs in a container of the root podman instance,
# which starts containers with any privilege and any host directory
# mounted. mkdir and chmod create the storage and metadata
# directories of that instance. Delta containers, additional layers
# and include sections are provisioned with test, cp, rsync, tar
# and sh. sh runs the /systemfiles script shipped in the delta
# container as root: registering such a container means trusting its
# author with root, independent of this policy.
#
# A system wide podman flake can only be run by users with this
# rule, which makes them equivalent to root.
#
Cmnd_Alias FLAKE_PODMAN_SYSTEM = FLAKE_PODMAN, \
    /usr/bin/true, /usr/bin/test, /usr/bin/mkdir, /usr/bin/chmod, \
    /usr/bin/cp, /usr/bin/rsync, /usr/bin/tar, /usr/bin/sh

%flake-pilot ALL = (root) FLAKE_PODMAN_SYSTEM

#
# firecracker flakes
# -------------------------------------------------------------------
# Used by: firecracker-pilot, for system wide flakes as well as for
#          flakes registered by the calling user
# Runs as: root
# GRANTS:  ROOT
#
# The VM itself runs as the calling user. Only VMs with an overlay
# and include sections need root: their image and overlay are
# mounted with mount and umount, the directories of the overlay are
# created with mkdir and chmod, and the includes are provisioned
# with tar and rsync. If no firecracker flake uses include sections,
# firecracker flakes need no root privileges and this rule can be
# deleted.
#
Cmnd_Alias FLAKE_FIRECRACKER = \
    /usr/bin/true, /usr/bin/mkdir, /usr/bin/chmod, \
    /usr/bin/mount, /usr/bin/umount, /usr/bin/tar, /usr/bin/rsync

%flake-pilot ALL = (root) FLAKE_FIRECRACKER

#
# flake-ctl firecracker pull
# -------------------------------------------------------------------
# Runs as: root
# GRANTS:  ROOT
#
# The downloaded root filesystem image is mounted to add the sci
# program and the directories the VM needs. mv moves the image into
# the system wide image store.
#
Cmnd_Alias FLAKE_FIRECRACKER_PULL = \
    /usr/bin/mount, /usr/bin/umount, /usr/bin/mkdir, /usr/bin/cp, \
    /usr/bin/mv

%flake-pilot ALL = (root) FLAKE_FIRECRACKER_PULL

#
# flake-ctl firecracker network init, add, remove
# -------------------------------------------------------------------
# Runs as: root
# GRANTS:  ROOT
#
# Enables IP forwarding, creates the NAT and forward rules and the
# TAP devices and routes of the VMs. sysctl can change any kernel
# parameter, e.g kernel.core_pattern which names a program the kernel
# runs as root. ip can run any program as root through
# 'ip netns exec'.
#
# The network setup changes the host, not a single flake. Consider
# running these commands as root instead of granting this rule.
#
Cmnd_Alias FLAKE_NETWORK = \
    /usr/sbin/sysctl, /usr/sbin/iptables, /usr/sbin/ip

%flake-pilot ALL = (root) FLAKE_NETWORK

#
# flake-ctl firecracker volume export, release
# -------------------------------------------------------------------
# Runs as: root
# GRANTS:  ROOT
#
# install writes /etc/exports, systemctl starts the NFS server and
# exportfs activates the exports. install can overwrite any file.
# systemctl can start a unit file written by the user. exportfs can
# export any directory, / included, to any host with root access.
#
# As with the network setup, consider running these commands as
# root instead of granting this rule.
#
Cmnd_Alias FLAKE_NFS = \
    /usr/bin/install, /usr/bin/systemctl, /usr/sbin/exportfs

%flake-pilot ALL = (root) FLAKE_NFS

#
# bubblewrap flakes
# -------------------------------------------------------------------
# Used by: bubblewrap-pilot, for system wide flakes as well as for
#          flakes registered by the calling user
# Runs as: root
# GRANTS:  ROOT
#
# mount and umount create and delete the overlay which becomes the
# root filesystem of the sandbox. mount as root can mount any image
# or bind mount any file over a system file, umount can remove any
# mount of the host.
#
Cmnd_Alias FLAKE_BUBBLEWRAP = /usr/bin/mount, /usr/bin/umount

%flake-pilot ALL = (root) FLAKE_BUBBLEWRAP
